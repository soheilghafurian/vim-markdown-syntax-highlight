" test/math_conceal_highlight.vader
" Tests for LaTeX math conceal highlighting. When 'conceallevel' is set, the
" included TeX syntax conceals math commands into Unicode glyphs (\alpha -> α,
" x^2 -> x², \leq -> ≤). Vim draws those glyphs with the global `Conceal`
" highlight group, which many dark colorschemes set to a near-black grey,
" leaving the symbols almost invisible. The plugin gives Conceal a calm,
" readable foreground (a dimmed white) so the glyphs stay legible without
" out-shining the prose. Opt out via g:vim_markdown_math_conceal_hi; change the
" shade via g:vim_markdown_math_conceal_color.
"
" Run with:
"   vim -u NONE -N +'set rtp+=.' +'runtime plugin/vader.vim' +'Vader! test/math_conceal_highlight.vader'
" or from within vim:
"   :Vader test/math_conceal_highlight.vader

" ============================================================================
" Default: Conceal is made readable (dimmed white) when math is enabled
" ============================================================================

Given markdown (inline and display math):
  Inline $E = mc^2$ here.

  $$\sum_{i=1}^{n} x_i^2 \leq \alpha$$

Execute (with math on, Conceal gets the default dimmed-white foreground):
  let g:vim_markdown_math = 1
  unlet! g:vim_markdown_math_conceal_hi
  unlet! g:vim_markdown_math_conceal_color
  " A dark colorscheme would leave Conceal as a dim grey; emulate that.
  highlight Conceal guifg=#666666 ctermfg=242
  set filetype=markdown
  unlet! b:current_syntax | runtime syntax/markdown.vim
  AssertEqual '#cccccc', synIDattr(synIDtrans(hlID('Conceal')), 'fg#'),
  \ 'Conceal should get the default dimmed-white foreground (#cccccc)'

" ============================================================================
" Custom colour: g:vim_markdown_math_conceal_color overrides the shade
" ============================================================================

Execute (a custom conceal colour is honoured):
  let g:vim_markdown_math = 1
  unlet! g:vim_markdown_math_conceal_hi
  let g:vim_markdown_math_conceal_color = '#abcdef'
  set filetype=markdown
  unlet! b:current_syntax | runtime syntax/markdown.vim
  AssertEqual '#abcdef', synIDattr(synIDtrans(hlID('Conceal')), 'fg#'),
  \ 'Conceal should use g:vim_markdown_math_conceal_color when set'
  unlet! g:vim_markdown_math_conceal_color

" ============================================================================
" Opt-out: leave the colorscheme's own Conceal colour alone
" ============================================================================

Execute (with the opt-out, Conceal keeps the colorscheme colour):
  let g:vim_markdown_math = 1
  let g:vim_markdown_math_conceal_hi = 0
  highlight Conceal guifg=#666666 ctermfg=242
  set filetype=markdown
  unlet! b:current_syntax | runtime syntax/markdown.vim
  AssertEqual '#666666', synIDattr(synIDtrans(hlID('Conceal')), 'fg#'),
  \ 'With the opt-out, Conceal should keep its dim colorscheme colour'
  unlet! g:vim_markdown_math_conceal_hi

" ============================================================================
" Math disabled: the plugin must not touch Conceal at all
" ============================================================================

Execute (with math off, Conceal is left untouched):
  let g:vim_markdown_math = 0
  unlet! g:vim_markdown_math_conceal_hi
  highlight Conceal guifg=#666666 ctermfg=242
  set filetype=markdown
  unlet! b:current_syntax | runtime syntax/markdown.vim
  AssertEqual '#666666', synIDattr(synIDtrans(hlID('Conceal')), 'fg#'),
  \ 'With math off, the plugin should not touch Conceal'
